# 1*2*3*...n Factorial of a Number
n=int(input("Factorial of :"))
print("-----using for loop-----")
sum=1
for x in range(1,n+1,1):
    print(x,"*",end=" ")
    sum=sum*x
print("...n")
print()
print(f"Factorial of {n}! = {sum}")
print()
print("-----using while loop-----")
result=1
i=1
while i<=n:
    print(i,"*",end=" ")
    result=result*i
    i=i+1
print("...n")
print()
print(f"Factorial of {n}! ={result}")
