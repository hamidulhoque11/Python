#while loop
n=int(input("Enter your value:"))
#while loop
print ("----while loop----")
i=1
sum=0
while i<=n:
    print(i,end=" ")
    sum=sum+i
    i=i+1
print()
print("Sum of n =",sum)
print()
    #forloop
print ("----for loop----")
result=0
for x in range(1,n+1,1):
    print(x,end=" ")
    result=result+x
print()
print("sum of n:",result)
