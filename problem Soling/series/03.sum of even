n=int(input("Enter any value :"))
print("-----using for loop-----")
sum=0
for x in range(1,n+1,2):
    print(x,end=" ")
    sum=sum+x
print()
print("Sum of odd value:",sum)
print()
print("-----using while loop-----")
result=0
i=1
while i<=n:
    print(i,end=" ")
    result=result+i
    i=i+2
print()
print("sum of odd value:",result)

