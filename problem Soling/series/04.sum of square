#1^2 +2^2 +3^2 + 4^2+....n^2 sum of square
n=int(input("Enter any value :"))
print("-----using for loop-----")
sum=0

for x in range(1,n+1,1):
    power=x*x
    sum=sum+power
    print(x,"^2","=",power)
print()
print("Sum of square value:",sum)
print()
print("-----using while loop-----")
result=0
i=1
while i<=n:
    power=i*i
    result=result+power
    print(i,"^2 =",power)
    i=i+1
print()
print("sum of Square value:",result)
