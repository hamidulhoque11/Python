        self.name=name
        self.id=id
        self.cgpa=cgpa
        self.batch=batch
        self.blood=blood

    def display(self):
        print("name:",self.name)
        print("id:",self.id)
        print("cgpa:",self.cgpa)
        print("batch:",self.batch)
        print("blood:",self.blood)

