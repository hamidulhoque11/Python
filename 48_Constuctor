class student:
    name=""
    id=""
    cgpa=""
    batch=""
    def __init__(self,name,id,cgpa,batch):
        self.name=name
        self.id=id
        self.cgpa=cgpa
        self.batch=batch
    def display(self):
        print("name =",self.name)
        print("id =",self.id)
        print("cpga =",self.cgpa)
        print("batch =",self.batch)
        print()
